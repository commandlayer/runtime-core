{
  "name": "@commandlayer/runtime-core",
  "version": "1.3.0",
  "description": "CommandLayer protocol core — canonicalization, Ed25519 crypto, receipt signing/verification, ENS resolution",
  "license": "Apache-2.0",
  "author": "CommandLayer <team@commandlayer.org>",
  "homepage": "https://commandlayer.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/commandlayer/runtime-core.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./canonicalize": {
      "import": "./dist/canonicalize.js",
      "types": "./dist/canonicalize.d.ts"
    },
    "./crypto": {
      "import": "./dist/crypto.js",
      "types": "./dist/crypto.d.ts"
    },
    "./ens": {
      "import": "./dist/ens.js",
      "types": "./dist/ens.d.ts"
    },
    "./receipt": {
      "import": "./dist/receipt.js",
      "types": "./dist/receipt.d.ts"
    },
    "./execution-evidence": {
      "import": "./dist/execution-evidence.js",
      "types": "./dist/execution-evidence.d.ts"
    },
    "./compat": {
      "import": "./dist/compat.js",
      "types": "./dist/compat.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "prepare": "npm run build",
    "test": "tsx --test",
    "test:build": "npm run build && node --test dist/test/**/*.test.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "ethers": "^6.13.0"
  },
  "peerDependenciesMeta": {
    "ethers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ethers": "^6.13.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "commandlayer",
    "agent",
    "receipt",
    "ed25519",
    "ens",
    "protocol",
    "verification",
    "signing",
    "canonicalization"
  ]
}
